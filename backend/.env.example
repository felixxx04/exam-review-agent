# PostgreSQL 17 + pgvector is the V2 application database.
DATABASE_URL=postgresql+asyncpg://exam_review:exam-review-dev@localhost:5432/exam_review
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_data

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Legacy providers remain readable until the Agent runtime is replaced.
# V2 application flows use DeepSeek only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas
ARK_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HF_ENDPOINT=

DEFAULT_LLM_PROVIDER=deepseek
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Local HTTP only. Public deployments must use true behind HTTPS.
AUTH_COOKIE_SECURE=false

MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
