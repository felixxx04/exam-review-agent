# PostgreSQL 17 + pgvector is the V2 application database.
DATABASE_URL=postgresql+asyncpg://exam_review:exam-review-dev@localhost:5432/exam_review
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_data

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Legacy providers remain readable until the Agent runtime is replaced.
# V2 application flows use DeepSeek only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas
ARK_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HF_ENDPOINT=

DEFAULT_LLM_PROVIDER=deepseek
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Local HTTP only. Public deployments must use true behind HTTPS.
AUTH_COOKIE_SECURE=false

MAX_UPLOAD_SIZE_MB=50
MAX_ARCHIVE_UNCOMPRESSED_MB=128

# Private S3-compatible object storage. For a host-run API use localhost;
# a Dockerized API should use http://minio:9000 internally and keep the public
# endpoint reachable by the browser as a separate value.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# Non-loopback HTTP is rejected by default. Set true only when the API and
# MinIO share a trusted private Docker network; never enable it for public S3.
S3_ALLOW_INSECURE_HTTP=false
S3_REGION=us-east-1
S3_BUCKET=exam-review-materials
S3_ACCESS_KEY_ID=replace-with-a-minio-app-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-minio-app-secret
S3_PRESIGNED_URL_TTL_SECONDS=300
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
