POSTGRES_DB=exam_review
POSTGRES_ADMIN_USER=exam_review_admin
POSTGRES_ADMIN_PASSWORD=exam-review-admin-dev
POSTGRES_APP_PASSWORD=exam-review-dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=replace-with-a-local-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-local-minio-root-password
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local S3-compatible application identity. The MinIO bootstrap service grants
# this identity access only to the private bucket below; it is not a root user.
S3_BUCKET=exam-review-materials
S3_ACCESS_KEY_ID=replace-with-a-minio-app-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-minio-app-secret
